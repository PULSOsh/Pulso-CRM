NEXT_PUBLIC_SITE_URL=https://pulso.example.com
NEXT_PUBLIC_CONTACT_URL=https://wa.me/5500000000000

BETTER_AUTH_SECRET="your-secret-key-at-least-32-chars-long"

# Opcional — SHA do commit em produção, exibido em /api/health (CRM-F0-09)
# para saber exatamente qual versão está no ar. Preencher via --build-arg no
# Dockerfile/Dokploy (ex.: ARG COMMIT_SHA / ENV COMMIT_SHA=$COMMIT_SHA); sem
# valor, o campo "commit" do health check retorna null (não é obrigatório).
COMMIT_SHA=

# Nível mínimo dos logs estruturados do servidor (debug/info/warn/error).
LOG_LEVEL=info

# Obrigatórias para rodar `npm run db:seed` — nunca commitar valores reais aqui.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
